import test from 'node:test';
import assert from 'node:assert/strict';

const converter = require('../www/js/coordinate-converter.js');

test('EPSG:3997 origin is near the defined false origin', () => {
  const result = converter.wgs84ToEpsg3997(25.25, 55.33333333333334);
  assert.ok(Math.abs(result.easting - 500000) < 10, 'Easting should be near 500000 m at the projection origin.');
  assert.ok(Math.abs(result.northing) < 10, 'Northing should be near 0 m at the projection origin.');
});

test('WGS84 coordinate round-trips to EPSG:3997 and back within tolerance', () => {
  const sourceLatitude = 25.1970;
  const sourceLongitude = 55.2744;
  const projected = converter.wgs84ToEpsg3997(sourceLatitude, sourceLongitude);
  const roundTrip = converter.epsg3997ToWgs84(projected.easting, projected.northing);

  assert.ok(Math.abs(roundTrip.latitude - sourceLatitude) < 1e-4, 'Latitude round-trip tolerance failed.');
  assert.ok(Math.abs(roundTrip.longitude - sourceLongitude) < 1e-4, 'Longitude round-trip tolerance failed.');
});

test('DMS to decimal degrees conversion is correct for a valid coordinate', () => {
  const decimal = converter.dmsToDecimalDegrees('25° 11′ 49.20″ N');
  assert.ok(Math.abs(decimal - 25.197) < 0.001, 'DMS conversion should match the decimal equivalent within tolerance.');
});

test('Decimal degrees to DMS conversion round-trips to the original value', () => {
  const original = 25.197;
  const dms = converter.decimalDegreesToDms(original, 'lat');
  const converted = converter.dmsToDecimalDegrees(dms.formatted);
  assert.ok(Math.abs(converted - original) < 0.001, 'DMS round-trip tolerance failed.');
});

test('Invalid latitude and longitude values reject invalid ranges', () => {
  assert.throws(() => converter.validateLatitude(95), /Latitude must be between -90 and 90 degrees/);
  assert.throws(() => converter.validateLongitude(181), /Longitude must be between -180 and 180 degrees/);
});
